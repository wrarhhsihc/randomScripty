local stars = {}
local function createStar()
    local star = Instance.new("Frame")
    local s = math.random(1, 3)
    star.Size = UDim2.new(0, s, 0, s)
    star.Position = UDim2.new(math.random() * 0.95 + 0.025, 0, math.random() * 0.95 + 0.025, 0)
