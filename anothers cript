-- Tab switching
local tabButtons = {bypassTabBtn, waypointTabBtn, keybindTabBtn}
local tabContents = {bypassContent, waypointContent, keybindContent}
local tabNames = {"Bypass", "Waypoint", "Keybind"}
local tabPositions = {0, 1/3, 2/3}

local function switchTab(tabName)
    if currentTab == tabName then return end
    local oi, ni
    for i, n in ipairs(tabNames) do
        if n == currentTab then oi = i end
        if n == tabName then ni = i end
    end
    currentTab = tabName

    TweenService:Create(tabHighlight, tweenInfo, {Position = UDim2.new(tabPositions[ni], 3, 0.5, -15)}):Play()
    TweenService:Create(tabIndicator, tweenInfo, {Position = UDim2.new(tabPositions[ni] + 1/6, -10, 1, 3)}):Play()

    for i, btn in ipairs(tabButtons) do
        if i == ni then
            TweenService:Create(btn, tweenFast, {TextColor3 = Color3.fromRGB(230, 220, 255)}):Play()
            btn.Font = Enum.Font.GothamBold
        else
            TweenService:Create(btn, tweenFast, {TextColor3 = Color3.fromRGB(130, 125, 155)}):Play()
            btn.Font = Enum.Font.GothamMedium
        end
    end

    local sd = ni > oi and 1 or -1
    TweenService:Create(tabContents[oi], TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
        Position = UDim2.new(-0.3 * sd, 10, 0, 95)
    }):Play()
    task.delay(0.15, function() tabContents[oi].Visible = false end)

    tabContents[ni].Position = UDim2.new(0.3 * sd, 10, 0, 95)
    tabContents[ni].Visible = true
    TweenService:Create(tabContents[ni], TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
        Position = UDim2.new(0, 10, 0, 95)
    }):Play()
end

bypassTabBtn.MouseButton1Click:Connect(function() createRipple(tabBar); switchTab("Bypass") end)
waypointTabBtn.MouseButton1Click:Connect(function() createRipple(tabBar); switchTab("Waypoint") end)
keybindTabBtn.MouseButton1Click:Connect(function() createRipple(tabBar); switchTab("Keybind") end)

