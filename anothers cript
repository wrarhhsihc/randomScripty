	-- Key button - listen for key press
	keyBtn.MouseButton1Click:Connect(function()
		createRipple(keyBtn)

		if listeningForKey == slotId then
			-- Cancel listening
			listeningForKey = nil
			keyLabel.Text = keybinds[slotId].key and keybinds[slotId].key.Name or "?"
			keyLabel.TextColor3 = keybinds[slotId].key and Color3.fromRGB(200, 180, 255) or Color3.fromRGB(100, 90, 130)
			TweenService:Create(keyBtnStroke, tweenFast, {Color = Color3.fromRGB(70, 60, 120)}):Play()
			TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(40, 35, 65)}):Play()
			return
		end

		listeningForKey = slotId
		keyLabel.Text = "..."
		keyLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		TweenService:Create(keyBtnStroke, tweenFast, {Color = Color3.fromRGB(200, 160, 60)}):Play()
		TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(60, 50, 30)}):Play()

		-- Pulsing animation while listening
		task.spawn(function()
			while listeningForKey == slotId do
				TweenService:Create(keyLabel, TweenInfo.new(0.4), {TextTransparency = 0.4}):Play()
				task.wait(0.4)
				if listeningForKey ~= slotId then break end
				TweenService:Create(keyLabel, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
				task.wait(0.4)
			end
			keyLabel.TextTransparency = 0
		end)
	end)

	-- Hover effects
	gearBtn.MouseEnter:Connect(function()
		if not keybindSettingsOpen[slotId] then
			TweenService:Create(gearBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(58, 48, 95)}):Play()
			TweenService:Create(gearStroke, tweenFast, {Transparency = 0}):Play()
		end
	end)
	gearBtn.MouseLeave:Connect(function()
		if not keybindSettingsOpen[slotId] then
			TweenService:Create(gearBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(45, 40, 75)}):Play()
			TweenService:Create(gearStroke, tweenFast, {Transparency = 0.4}):Play()
		end
	end)

	keyBtn.MouseEnter:Connect(function()
		if listeningForKey ~= slotId then
			TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(50, 45, 80)}):Play()
			TweenService:Create(keyBtnStroke, tweenFast, {Transparency = 0}):Play()
		end
	end)
	keyBtn.MouseLeave:Connect(function()
		if listeningForKey ~= slotId then
			TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(40, 35, 65)}):Play()
			TweenService:Create(keyBtnStroke, tweenFast, {Transparency = 0.3}):Play()
		end
	end)

	slot.MouseEnter:Connect(function()
		TweenService:Create(slotStroke, tweenFast, {Color = Color3.fromRGB(80, 65, 140), Transparency = 0}):Play()
		TweenService:Create(slot, tweenFast, {BackgroundColor3 = Color3.fromRGB(30, 28, 48)}):Play()
	end)
	slot.MouseLeave:Connect(function()
		TweenService:Create(slotStroke, tweenFast, {Color = Color3.fromRGB(50, 45, 80), Transparency = 0.4}):Play()
		TweenService:Create(slot, tweenFast, {BackgroundColor3 = Color3.fromRGB(26, 24, 42)}):Play()
	end)

	-- Entrance animation
	TweenService:Create(slot, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(1, -12, 0, 42), BackgroundTransparency = 0
	}):Play()

	keybindSlotFrames[slotId] = slot
	return slot
end

