minimizeBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		lastSize = outerGlow.Size
		TweenService:Create(outerGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, lastSize.X.Offset, 0, 42)
		}):Play()
		minimizeBtn.Text = "+"
		resizeHandle.Visible = false
	else
		TweenService:Create(outerGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = lastSize
		}):Play()
		minimizeBtn.Text = "−"
