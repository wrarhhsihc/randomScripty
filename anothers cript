-- ============================================
-- RIPPLE EFFECT FUNCTION
-- ============================================
local function createRipple(parent, inputPosition)
	local ripple = Instance.new("Frame")
	ripple.BackgroundColor3 = Color3.fromRGB(150, 120, 255)
	ripple.BackgroundTransparency = 0.6
	ripple.BorderSizePixel = 0
	ripple.ZIndex = 99

	local parentPos = parent.AbsolutePosition
	local parentSize = parent.AbsoluteSize
	local relX = inputPosition and (inputPosition.X - parentPos.X) or (parentSize.X / 2)
	local relY = inputPosition and (inputPosition.Y - parentPos.Y) or (parentSize.Y / 2)

	ripple.Position = UDim2.new(0, relX, 0, relY)
	ripple.Size = UDim2.new(0, 0, 0, 0)
	ripple.AnchorPoint = Vector2.new(0.5, 0.5)
	ripple.Parent = parent

	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(1, 0)
	rc.Parent = ripple

	local maxSize = math.max(parentSize.X, parentSize.Y) * 2.5

	TweenService:Create(ripple, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, maxSize, 0, maxSize),
		BackgroundTransparency = 1
	}):Play()

	task.delay(0.6, function()
		ripple:Destroy()
	end)
end

-- ============================================
-- BUTTON PULSE FUNCTION
-- ============================================
local function pulseButton(btn, color)
	local originalColor = btn.BackgroundColor3
	TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quint), {
		BackgroundColor3 = color or Color3.fromRGB(100, 70, 200)
	}):Play()
	task.wait(0.1)
	TweenService:Create(btn, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
		BackgroundColor3 = originalColor
	}):Play()
end

-- ============================================
-- SCALE BOUNCE FUNCTION
-- ============================================
local function scaleBounce(frame, scaleFrom, scaleTo)
	frame.Size = scaleFrom
	TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = scaleTo
	}):Play()
end

