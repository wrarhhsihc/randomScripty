-- ============================================
-- TAB SWITCHING
-- ============================================
local tabButtons = {bypassTabBtn, waypointTabBtn, keybindTabBtn}
local tabContents = {bypassContent, waypointContent, keybindContent}
local tabNames = {"Bypass", "Waypoint", "Keybind"}
local tabPositions = {0, 1/3, 2/3}

local function switchTab(tabName)
	if currentTab == tabName then return end

	local oldIndex, newIndex
	for i, n in ipairs(tabNames) do
		if n == currentTab then oldIndex = i end
		if n == tabName then newIndex = i end
	end

	currentTab = tabName

	-- Highlight slide
	TweenService:Create(tabHighlight, tweenInfo, {
		Position = UDim2.new(tabPositions[newIndex], 3, 0.5, -15)
	}):Play()
	TweenService:Create(tabIndicator, tweenInfo, {
		Position = UDim2.new(tabPositions[newIndex] + (1/6), -10, 1, 3)
	}):Play()

	-- Update button styles
	for i, btn in ipairs(tabButtons) do
		if i == newIndex then
			TweenService:Create(btn, tweenFast, {TextColor3 = Color3.fromRGB(230, 220, 255)}):Play()
			btn.Font = Enum.Font.GothamBold
		else
			TweenService:Create(btn, tweenFast, {TextColor3 = Color3.fromRGB(140, 140, 160)}):Play()
			btn.Font = Enum.Font.GothamMedium
		end
	end

	local slideDir = newIndex > oldIndex and 1 or -1

	-- Slide out old content
	local oldContent = tabContents[oldIndex]
	TweenService:Create(oldContent, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
		Position = UDim2.new(-0.3 * slideDir, 10, 0, 95)
	}):Play()
