local activeParticles = {}

local function spawnParticle()
	local particle = Instance.new("Frame")
	local size = math.random(2, 5)
	particle.Size = UDim2.new(0, size, 0, size)
	particle.Position = UDim2.new(math.random() * 0.9 + 0.05, 0, 1.05, 0)
	particle.BackgroundColor3 = Color3.fromHSV(0.72 + math.random() * 0.12, 0.5 + math.random() * 0.3, 0.6 + math.random() * 0.4)
	particle.BackgroundTransparency = 0.5 + math.random() * 0.3
	particle.BorderSizePixel = 0
	particle.ZIndex = 0
	particle.Parent = particleContainer

	local pCorner = Instance.new("UICorner")
	pCorner.CornerRadius = UDim.new(1, 0)
	pCorner.Parent = particle

	local duration = 3 + math.random() * 4
	local xDrift = (math.random() - 0.5) * 0.15

	local moveTween = TweenService:Create(particle, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Position = UDim2.new(particle.Position.X.Scale + xDrift, 0, -0.1, 0),
		BackgroundTransparency = 1,
		Size = UDim2.new(0, size * 0.3, 0, size * 0.3)
	})

	moveTween:Play()
	moveTween.Completed:Connect(function()
		particle:Destroy()
	end)

	table.insert(activeParticles, particle)
	if #activeParticles > 15 then
		local old = table.remove(activeParticles, 1)
		if old and old.Parent then old:Destroy() end
	end
end

-- Particle spawner
local particleTimer = 0
local particleConnection = RunService.Heartbeat:Connect(function(dt)
	particleTimer = particleTimer + dt
	if particleTimer >= 0.6 then
