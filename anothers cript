local keybindSlotFrames = {}

local function getWaypointName(wpIndex)
	if not wpIndex then return "None" end
	for _, wp in ipairs(waypoints) do
		if wp.index == wpIndex then return wp.name end
	end
	return "Deleted"
end

local function getWaypointPosition(wpIndex)
	if not wpIndex then return nil end
	for _, wp in ipairs(waypoints) do
		if wp.index == wpIndex then return wp.position end
	end
	return nil
end

local function updateKeybindSlotDisplay(slotId)
	local slot = keybindSlotFrames[slotId]
	if not slot then return end
	local kb = keybinds[slotId]

	-- Update key display
	local keyLabel = slot:FindFirstChild("KeyLabel")
	if keyLabel then
		if kb.key then
			keyLabel.Text = kb.key.Name
			keyLabel.TextColor3 = Color3.fromRGB(200, 180, 255)
		else
			keyLabel.Text = "?"
			keyLabel.TextColor3 = Color3.fromRGB(100, 90, 130)
		end
	end

	-- Update waypoint display
	local wpLabel = slot:FindFirstChild("WaypointLabel")
	if wpLabel then
		if kb.waypointIndex then
			local name = getWaypointName(kb.waypointIndex)
			wpLabel.Text = "📍 " .. name
			wpLabel.TextColor3 = Color3.fromRGB(170, 160, 220)
		else
			wpLabel.Text = "No waypoint assigned"
			wpLabel.TextColor3 = Color3.fromRGB(80, 75, 110)
		end
	end

	-- Update status dot
	local sDot = slot:FindFirstChild("SlotDot")
	if sDot then
		if kb.key and kb.waypointIndex then
			TweenService:Create(sDot, tweenFast, {BackgroundColor3 = Color3.fromRGB(100, 220, 100)}):Play()
		elseif kb.key then
			TweenService:Create(sDot, tweenFast, {BackgroundColor3 = Color3.fromRGB(220, 180, 60)}):Play()
		else
			TweenService:Create(sDot, tweenFast, {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
		end
	end
end

