			wpBtnStroke.Color = (keybinds[slotId].waypointIndex == wp.index) 
				and Color3.fromRGB(110, 85, 200) or Color3.fromRGB(55, 50, 85)
			wpBtnStroke.Thickness = 1
			wpBtnStroke.Transparency = 0.3
			wpBtnStroke.Parent = wpBtn

			-- Question mark or waypoint number
			local btnLabel = Instance.new("TextLabel")
			btnLabel.Size = UDim2.new(1, 0, 0, 16)
			btnLabel.Position = UDim2.new(0, 0, 0, 2)
			btnLabel.BackgroundTransparency = 1
			btnLabel.Text = (keybinds[slotId].waypointIndex == wp.index) and "✓" or tostring(i)
			btnLabel.TextColor3 = (keybinds[slotId].waypointIndex == wp.index) 
				and Color3.fromRGB(140, 255, 140) or Color3.fromRGB(160, 150, 210)
			btnLabel.TextSize = 12
			btnLabel.Font = Enum.Font.GothamBold
			btnLabel.Parent = wpBtn

			local btnName = Instance.new("TextLabel")
			btnName.Size = UDim2.new(1, -4, 0, 10)
			btnName.Position = UDim2.new(0, 2, 0, 18)
			btnName.BackgroundTransparency = 1
			btnName.Text = wp.name
			btnName.TextColor3 = Color3.fromRGB(100, 95, 140)
			btnName.TextSize = 7
			btnName.Font = Enum.Font.Gotham
			btnName.TextTruncate = Enum.TextTruncate.AtEnd
			btnName.Parent = wpBtn

			local lastClickTime = 0

			wpBtn.MouseButton1Click:Connect(function()
				local now = tick()
				if keybinds[slotId].waypointIndex == wp.index and (now - lastClickTime) < 0.4 then
					-- Double click -> remove assignment
					keybinds[slotId].waypointIndex = nil
					createRipple(wpBtn)

					TweenService:Create(wpBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(80, 30, 30)}):Play()
					task.wait(0.15)

					updateKeybindSlotDisplay(slotId)
					refreshWaypointButtons()

					-- Flash feedback
					TweenService:Create(slot, tweenFast, {BackgroundColor3 = Color3.fromRGB(50, 25, 25)}):Play()
					task.wait(0.2)
					TweenService:Create(slot, tweenFast, {BackgroundColor3 = Color3.fromRGB(26, 24, 42)}):Play()
				else
					-- Single click -> assign
					keybinds[slotId].waypointIndex = wp.index
					createRipple(wpBtn)

					updateKeybindSlotDisplay(slotId)
					refreshWaypointButtons()

					-- Flash feedback
					TweenService:Create(slot, tweenFast, {BackgroundColor3 = Color3.fromRGB(30, 50, 30)}):Play()
					task.wait(0.2)
					TweenService:Create(slot, tweenFast, {BackgroundColor3 = Color3.fromRGB(26, 24, 42)}):Play()
				end
				lastClickTime = now
			end)

			wpBtn.MouseEnter:Connect(function()
				if keybinds[slotId].waypointIndex ~= wp.index then
					TweenService:Create(wpBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(45, 40, 75)}):Play()
