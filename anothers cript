-- ============================================
-- WAYPOINT FUNCTIONALITY
-- ============================================
local function createWaypointEntry(name, position, index)
	local entry = Instance.new("Frame")
	entry.Name = "Waypoint_" .. index
	entry.Size = UDim2.new(1, -8, 0, 36)
	entry.BackgroundColor3 = Color3.fromRGB(30, 28, 48)
	entry.BorderSizePixel = 0
	entry.LayoutOrder = index
	entry.Parent = waypointScroll

	local entryCorner = Instance.new("UICorner")
	entryCorner.CornerRadius = UDim.new(0, 8)
	entryCorner.Parent = entry

	local entryStroke = Instance.new("UIStroke")
	entryStroke.Color = Color3.fromRGB(50, 45, 75)
	entryStroke.Thickness = 1
	entryStroke.Transparency = 0.5
	entryStroke.Parent = entry

	-- Waypoint name
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0.5, -5, 0, 16)
	nameLabel.Position = UDim2.new(0, 10, 0, 3)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = "📍 " .. name
	nameLabel.TextColor3 = Color3.fromRGB(200, 195, 230)
	nameLabel.TextSize = 11
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = entry

	-- Coordinates
	local coordLabel = Instance.new("TextLabel")
	coordLabel.Size = UDim2.new(0.65, 0, 0, 12)
	coordLabel.Position = UDim2.new(0, 10, 0, 20)
	coordLabel.BackgroundTransparency = 1
	coordLabel.Text = string.format("%.0f, %.0f, %.0f", position.X, position.Y, position.Z)
	coordLabel.TextColor3 = Color3.fromRGB(90, 90, 115)
	coordLabel.TextSize = 9
	coordLabel.Font = Enum.Font.Gotham
	coordLabel.TextXAlignment = Enum.TextXAlignment.Left
	coordLabel.Parent = entry

	-- Teleport Button
	local tpBtn = Instance.new("TextButton")
	tpBtn.Name = "TeleportBtn"
	tpBtn.Size = UDim2.new(0, 50, 0, 24)
	tpBtn.Position = UDim2.new(1, -110, 0.5, -12)
	tpBtn.BackgroundColor3 = Color3.fromRGB(50, 40, 100)
	tpBtn.Text = "TP"
	tpBtn.TextColor3 = Color3.fromRGB(190, 175, 255)
	tpBtn.TextSize = 11
	tpBtn.Font = Enum.Font.GothamBold
	tpBtn.BorderSizePixel = 0
	tpBtn.AutoButtonColor = false
	tpBtn.Parent = entry

	local tpCorner = Instance.new("UICorner")
	tpCorner.CornerRadius = UDim.new(0, 6)
	tpCorner.Parent = tpBtn

	-- Delete Button
	local delBtn = Instance.new("TextButton")
	delBtn.Name = "DeleteBtn"
	delBtn.Size = UDim2.new(0, 28, 0, 24)
	delBtn.Position = UDim2.new(1, -53, 0.5, -12)
	delBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
	delBtn.Text = "✕"
	delBtn.TextColor3 = Color3.fromRGB(200, 130, 130)
	delBtn.TextSize = 11
	delBtn.Font = Enum.Font.GothamBold
	delBtn.BorderSizePixel = 0
	delBtn.AutoButtonColor = false
	delBtn.Parent = entry

	local delCorner = Instance.new("UICorner")
	delCorner.CornerRadius = UDim.new(0, 6)
	delCorner.Parent = delBtn

	-- TP hover
	tpBtn.MouseEnter:Connect(function()
		TweenService:Create(tpBtn, tweenFast, {
			BackgroundColor3 = Color3.fromRGB(70, 55, 140)
		}):Play()
	end)
	tpBtn.MouseLeave:Connect(function()
		TweenService:Create(tpBtn, tweenFast, {
			BackgroundColor3 = Color3.fromRGB(50, 40, 100)
		}):Play()
	end)

	-- Delete hover
	delBtn.MouseEnter:Connect(function()
		TweenService:Create(delBtn, tweenFast, {
			BackgroundColor3 = Color3.fromRGB(120, 40, 40)
		}):Play()
	end)
	delBtn.MouseLeave:Connect(function()
		TweenService:Create(delBtn, tweenFast, {
			BackgroundColor3 = Color3.fromRGB(80, 30, 30)
		}):Play()
	end)

	-- Teleport action
	tpBtn.MouseButton1Click:Connect(function()
		character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") then
			character.HumanoidRootPart.CFrame = CFrame.new(position)

			-- Flash feedback
			TweenService:Create(tpBtn, tweenFast, {
				BackgroundColor3 = Color3.fromRGB(80, 200, 80)
			}):Play()
			tpBtn.Text = "✓"
			task.wait(0.5)
			TweenService:Create(tpBtn, tweenFast, {
				BackgroundColor3 = Color3.fromRGB(50, 40, 100)
			}):Play()
			tpBtn.Text = "TP"
		end
	end)

	-- Delete action
	delBtn.MouseButton1Click:Connect(function()
		for i, wp in ipairs(waypoints) do
			if wp.index == index then
				table.remove(waypoints, i)
				break
			end
		end

		TweenService:Create(entry, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
			Size = UDim2.new(1, -8, 0, 0),
			BackgroundTransparency = 1
		}):Play()
		task.wait(0.2)
		entry:Destroy()

		if #waypoints == 0 then
			noWaypointsLabel.Visible = true
		end
	end)

	-- Entry hover
	entry.MouseEnter:Connect(function()
		TweenService:Create(entryStroke, tweenFast, {
			Color = Color3.fromRGB(80, 65, 130),
			Transparency = 0
		}):Play()
	end)
	entry.MouseLeave:Connect(function()
		TweenService:Create(entryStroke, tweenFast, {
			Color = Color3.fromRGB(50, 45, 75),
			Transparency = 0.5
		}):Play()
	end)

	return entry
end

-- Save waypoint
saveWaypointBtn.MouseButton1Click:Connect(function()
	character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		waypointCounter = waypointCounter + 1
		local pos = character.HumanoidRootPart.Position
		local wpName = "Waypoint " .. waypointCounter

		table.insert(waypoints, {
			name = wpName,
			position = pos,
			index = waypointCounter
		})

		noWaypointsLabel.Visible = false
		createWaypointEntry(wpName, pos, waypointCounter)

		-- Button flash feedback
		TweenService:Create(saveWaypointBtn, tweenFast, {
			BackgroundColor3 = Color3.fromRGB(40, 100, 40)
		}):Play()
		saveLabel.Text = "✓ Position Saved!"
		task.wait(0.6)
		TweenService:Create(saveWaypointBtn, tweenFast, {
			BackgroundColor3 = Color3.fromRGB(45, 35, 90)
		}):Play()
		saveLabel.Text = "Save Current Position"
