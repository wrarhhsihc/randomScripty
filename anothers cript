    b.Size = UDim2.new(1/3, 0, 1, 0)
    b.Position = UDim2.new(pos, 0, 0, 0)
    b.BackgroundTransparency = 1
    b.Text = text
    b.TextColor3 = pos == 0 and Color3.fromRGB(230, 220, 255) or Color3.fromRGB(130, 125, 155)
    b.TextSize = 11
    b.Font = pos == 0 and Enum.Font.GothamBold or Enum.Font.GothamMedium
    b.ZIndex = 7
    b.AutoButtonColor = false
    b.Parent = tabBar
    return b
end

