Button.Position = UDim2.new(0.05, 0, 0.4, 0)
Button.Text = "Set All CDs/Hold 0"
Button.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
Button.TextColor3 = Color3.new(1, 1, 1)
Button.TextScaled = true
Button.Parent = Main
Instance.new("UICorner", Button)

-- The Logic
local keywords = {"cooldown", "cd", "duration", "hold", "time", "delay", "charge", "cast"}

local function resetAll()
    local count = 0
    -- Search everywhere related to the player
    local searchAreas = {LocalPlayer.Character, LocalPlayer.Backpack, LocalPlayer}
    
    for _, area in pairs(searchAreas) do
        if area then
            -- 1. Reset Value Objects
            for _, v in pairs(area:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    for _, key in ipairs(keywords) do
                        if v.Name:lower():find(key) then
                            v.Value = 0
                            count = count + 1
                        end
                    end
                end
            end
            -- 2. Reset Attributes
            for attrName, attrValue in pairs(area:GetAttributes()) do
                for _, key in ipairs(keywords) do
                    if attrName:lower():find(key) and typeof(attrValue) == "number" then
                        area:SetAttribute(attrName, 0)
                        count = count + 1
                    end
                end
            end
        end
    end
    print("Success: Reset " .. count .. " variables.")
    Button.Text = "Done! (" .. count .. ")"
    task.wait(1)
    Button.Text = "Set All CDs/Hold 0"
end

Button.MouseButton1Click:Connect(resetAll)
