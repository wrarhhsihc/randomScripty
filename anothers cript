-- ============================================
-- BYPASS FUNCTIONALITY
-- ============================================
local function startBypass()
	loopConnection = task.spawn(function()
		while enabled do
			character = player.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				local count = 0
				for _, descendant in ipairs(workspace:GetDescendants()) do
					if descendant:IsA("ProximityPrompt") and descendant.Enabled then
						local parentPart = descendant.Parent
						if parentPart and parentPart:IsA("BasePart") then
							local distance = (character.HumanoidRootPart.Position - parentPart.Position).Magnitude
							if distance < 15 then
								descendant.HoldDuration = 0
								count = count + 1
							end
						end
					end
				end
				statusText.Text = "Status: Active | " .. count .. " prompts affected"
			end
			task.wait(0.3)
		end
	end)
end

-- Status dot pulse when active
local dotPulseConnection = nil

local function toggleBypass()
	enabled = not enabled

	-- Ripple on the toggle
	createRipple(toggleContainer)

	if enabled then
		-- Switch ON animations
		TweenService:Create(toggleSwitch, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {BackgroundColor3 = Color3.fromRGB(80, 50, 180)}):Play()
		TweenService:Create(toggleSwitchStroke, tweenInfo, {Color = Color3.fromRGB(130, 90, 230)}):Play()
		TweenService:Create(toggleKnob, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(1, -23, 0.5, -10),
			BackgroundColor3 = Color3.fromRGB(230, 210, 255)
		}):Play()
		TweenService:Create(knobGlow, tweenInfo, {Thickness = 2, Color = Color3.fromRGB(160, 120, 255)}):Play()
		TweenService:Create(statusDot, tweenInfo, {BackgroundColor3 = Color3.fromRGB(120, 255, 120)}):Play()
		TweenService:Create(statusDotStroke, tweenInfo, {Color = Color3.fromRGB(60, 180, 60)}):Play()
		TweenService:Create(toggleLabel, tweenInfo, {TextColor3 = Color3.fromRGB(230, 230, 250)}):Play()
		statusText.TextColor3 = Color3.fromRGB(120, 200, 120)

		-- Knob bounce
		task.delay(0.15, function()
			TweenService:Create(toggleKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
				Size = UDim2.new(0, 22, 0, 22)
			}):Play()
			task.wait(0.15)
			TweenService:Create(toggleKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
				Size = UDim2.new(0, 20, 0, 20)
			}):Play()
		end)

		-- Status dot pulsing
		dotPulseConnection = RunService.Heartbeat:Connect(function(dt)
			if statusDot and statusDot.Parent then
				local t = tick() * 3
				statusDot.BackgroundTransparency = 0.15 + math.sin(t) * 0.15
			end
		end)

		startBypass()
	else
		-- Switch OFF animations
		TweenService:Create(toggleSwitch, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {BackgroundColor3 = Color3.fromRGB(55, 55, 70)}):Play()
		TweenService:Create(toggleSwitchStroke, tweenInfo, {Color = Color3.fromRGB(70, 70, 90)}):Play()
		TweenService:Create(toggleKnob, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, 3, 0.5, -10),
			BackgroundColor3 = Color3.fromRGB(170, 170, 180)
		}):Play()
		TweenService:Create(knobGlow, tweenInfo, {Thickness = 0, Color = Color3.fromRGB(255, 255, 255)}):Play()
		TweenService:Create(statusDot, tweenInfo, {BackgroundColor3 = Color3.fromRGB(100, 100, 100)}):Play()
		TweenService:Create(statusDotStroke, tweenInfo, {Color = Color3.fromRGB(60, 60, 60)}):Play()
		TweenService:Create(toggleLabel, tweenInfo, {TextColor3 = Color3.fromRGB(190, 190, 210)}):Play()
		statusDot.BackgroundTransparency = 0
		statusText.Text = "Status: Inactive"
		statusText.TextColor3 = Color3.fromRGB(100, 100, 120)

		if dotPulseConnection then dotPulseConnection:Disconnect(); dotPulseConnection = nil end
	end
end

