-- ============================================
-- ANIMATED OUTLINE COLOR CYCLE
-- ============================================
local outlineHue = 0
local outlineConnection = RunService.Heartbeat:Connect(function(dt)
	outlineHue = (outlineHue + dt * 0.08) % 1

	-- Main stroke color cycles through purple-blue-pink range
	local h1 = (0.72 + math.sin(outlineHue * math.pi * 2) * 0.08)
	local color1 = Color3.fromHSV(h1 % 1, 0.6, 0.85)
	mainStroke.Color = color1

	-- Inner stroke follows slightly offset
	local h2 = (0.72 + math.sin((outlineHue + 0.3) * math.pi * 2) * 0.08)
	local color2 = Color3.fromHSV(h2 % 1, 0.5, 0.55)
	innerStroke.Color = color2

	-- Glow layers pulse
	local pulse = 0.6 + math.sin(outlineHue * math.pi * 2 * 1.5) * 0.15
	glowLayer1.ImageTransparency = pulse + 0.1
	glowLayer2.ImageTransparency = pulse - 0.05

	-- Glow color follows main
	local glowColor = Color3.fromHSV(h1 % 1, 0.7, 0.75)
	glowLayer1.ImageColor3 = glowColor
	glowLayer2.ImageColor3 = color1
end)

