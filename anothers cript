local function closeRename()
    TweenService:Create(renameOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
    TweenService:Create(renameDialog, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 200, 0, 20), BackgroundTransparency = 0.8
    }):Play()
    TweenService:Create(rdGlow, TweenInfo.new(0.2), {ImageTransparency = 1}):Play()
    task.wait(0.2); renameOverlay.Visible = false
    activeRenameIndex, activeRenameLabel = nil, nil
end

local function confirmRename()
    local nn = rdInput.Text
    if nn == "" then nn = "Waypoint" end
    if #nn > 24 then nn = nn:sub(1, 24) end
    for _, wp in ipairs(waypoints) do
        if wp.index == activeRenameIndex then wp.name = nn; break end
    end
    if activeRenameLabel then
        activeRenameLabel.Text = "📍 " .. nn
        TweenService:Create(activeRenameLabel, tweenFast, {TextColor3 = Color3.fromRGB(140, 250, 140)}):Play()
        local ref = activeRenameLabel
        task.delay(0.3, function()
            if ref and ref.Parent then TweenService:Create(ref, tweenFast, {TextColor3 = Color3.fromRGB(190, 185, 225)}):Play() end
        end)
    end
    closeRename()
end

