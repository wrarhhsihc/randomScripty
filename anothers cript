		end

		for i, wp in ipairs(waypoints) do
			local wpBtn = Instance.new("TextButton")
			wpBtn.Name = "WpBtn_" .. wp.index
			wpBtn.LayoutOrder = i
			wpBtn.BackgroundColor3 = (keybinds[slotId].waypointIndex == wp.index) 
