		task.wait()
		local rows = math.ceil(#waypoints / 5)
		local contentHeight = 36 + rows * 36
		if keybindSettingsOpen[slotId] then
			TweenService:Create(settingsPanel, tweenInfo, {Size = UDim2.new(1, -16, 0, contentHeight)}):Play()
			TweenService:Create(slot, tweenInfo, {Size = UDim2.new(1, -12, 0, 42 + contentHeight + 8)}):Play()
		end
	end

	-- Gear button toggle
	gearBtn.MouseButton1Click:Connect(function()
		keybindSettingsOpen[slotId] = not keybindSettingsOpen[slotId]
		createRipple(gearBtn)

		if keybindSettingsOpen[slotId] then
			settingsPanel.Visible = true
			refreshWaypointButtons()

			local rows = math.max(1, math.ceil(math.max(1, #waypoints) / 5))
			local contentHeight = 36 + rows * 36

			TweenService:Create(settingsPanel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, -16, 0, contentHeight)
			}):Play()
			TweenService:Create(slot, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, -12, 0, 42 + contentHeight + 8)
			}):Play()
			TweenService:Create(gearBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(65, 50, 110)}):Play()
			TweenService:Create(gearStroke, tweenFast, {Color = Color3.fromRGB(120, 90, 200)}):Play()

			-- Rotate gear icon
			TweenService:Create(gearBtn, TweenInfo.new(0.3), {Rotation = 90}):Play()
		else
