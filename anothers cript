local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local tweenFast = TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

-- ============================================
-- TAB SWITCHING
-- ============================================
local function switchTab(tabName)
	currentTab = tabName

	if tabName == "Bypass" then
		TweenService:Create(tabHighlight, tweenInfo, {
			Position = UDim2.new(0, 3, 0.5, -15)
		}):Play()
		TweenService:Create(bypassTabBtn, tweenFast, {
			TextColor3 = Color3.fromRGB(230, 220, 255)
		}):Play()
		bypassTabBtn.Font = Enum.Font.GothamBold
		TweenService:Create(waypointTabBtn, tweenFast, {
			TextColor3 = Color3.fromRGB(140, 140, 160)
		}):Play()
		waypointTabBtn.Font = Enum.Font.GothamMedium

		bypassContent.Visible = true
		waypointContent.Visible = false
	else
		TweenService:Create(tabHighlight, tweenInfo, {
			Position = UDim2.new(0.5, 3, 0.5, -15)
		}):Play()
		TweenService:Create(waypointTabBtn, tweenFast, {
			TextColor3 = Color3.fromRGB(230, 220, 255)
		}):Play()
		waypointTabBtn.Font = Enum.Font.GothamBold
		TweenService:Create(bypassTabBtn, tweenFast, {
			TextColor3 = Color3.fromRGB(140, 140, 160)
		}):Play()
		bypassTabBtn.Font = Enum.Font.GothamMedium

		bypassContent.Visible = false
		waypointContent.Visible = true
	end
end

bypassTabBtn.MouseButton1Click:Connect(function()
	switchTab("Bypass")
end)

waypointTabBtn.MouseButton1Click:Connect(function()
	switchTab("Waypoint")
end)

-- ============================================
-- BYPASS FUNCTIONALITY
-- ============================================
local function startBypass()
	loopConnection = task.spawn(function()
		while enabled do
			character = player.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				local count = 0
				for _, descendant in ipairs(workspace:GetDescendants()) do
					if descendant:IsA("ProximityPrompt") and descendant.Enabled then
						local parentPart = descendant.Parent
						if parentPart and parentPart:IsA("BasePart") then
							local distance = (character.HumanoidRootPart.Position - parentPart.Position).Magnitude
							if distance < 15 then
								descendant.HoldDuration = 0
								count = count + 1
							end
						end
					end
				end
				statusText.Text = "Status: Active | " .. count .. " prompts affected"
			end
			task.wait(0.3)
		end
	end)
end

local function toggleBypass()
	enabled = not enabled

	if enabled then
		TweenService:Create(toggleSwitch, tweenInfo, {
			BackgroundColor3 = Color3.fromRGB(80, 50, 180)
		}):Play()
		TweenService:Create(toggleSwitchStroke, tweenInfo, {
			Color = Color3.fromRGB(120, 80, 220)
		}):Play()
		TweenService:Create(toggleKnob, tweenInfo, {
			Position = UDim2.new(1, -23, 0.5, -10),
			BackgroundColor3 = Color3.fromRGB(230, 210, 255)
		}):Play()
		TweenService:Create(knobGlow, tweenInfo, {
			Thickness = 2,
			Color = Color3.fromRGB(160, 120, 255)
		}):Play()
		TweenService:Create(statusDot, tweenInfo, {
			BackgroundColor3 = Color3.fromRGB(120, 255, 120)
		}):Play()
		TweenService:Create(toggleLabel, tweenInfo, {
			TextColor3 = Color3.fromRGB(230, 230, 250)
		}):Play()
		statusText.TextColor3 = Color3.fromRGB(120, 200, 120)
		startBypass()
	else
		TweenService:Create(toggleSwitch, tweenInfo, {
			BackgroundColor3 = Color3.fromRGB(55, 55, 70)
		}):Play()
		TweenService:Create(toggleSwitchStroke, tweenInfo, {
			Color = Color3.fromRGB(70, 70, 90)
		}):Play()
		TweenService:Create(toggleKnob, tweenInfo, {
