local dotPulseConnection = nil

local function startBypass()
    task.spawn(function()
        while enabled do
            character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local count = 0
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Enabled then
                        local pp = d.Parent
                        if pp and pp:IsA("BasePart") then
                            if (character.HumanoidRootPart.Position - pp.Position).Magnitude < 15 then
                                d.HoldDuration = 0; count += 1
                            end
                        end
                    end
                end
                statusText.Text = "Status: Active | " .. count .. " prompts"
            end
            task.wait(0.3)
        end
    end)
end

local function toggleBypass()
    enabled = not enabled
    createRipple(toggleContainer)
    if enabled then
        TweenService:Create(toggleSwitch, tweenInfo, {BackgroundColor3 = Color3.fromRGB(70, 40, 170)}):Play()
        TweenService:Create(tsStroke, tweenInfo, {Color = Color3.fromRGB(120, 80, 220)}):Play()
        TweenService:Create(toggleKnob, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -23, 0.5, -10), BackgroundColor3 = Color3.fromRGB(220, 200, 255)
        }):Play()
        TweenService:Create(knobGlow, tweenInfo, {Thickness = 2, Color = Color3.fromRGB(160, 120, 255)}):Play()
        TweenService:Create(statusDot, tweenInfo, {BackgroundColor3 = Color3.fromRGB(100, 240, 100)}):Play()
        TweenService:Create(toggleLabel, tweenInfo, {TextColor3 = Color3.fromRGB(225, 220, 250)}):Play()
        statusText.TextColor3 = Color3.fromRGB(100, 200, 100)
        dotPulseConnection = RunService.Heartbeat:Connect(function()
            if statusDot and statusDot.Parent then
                statusDot.BackgroundTransparency = 0.15 + math.sin(tick() * 3) * 0.15
            end
        end)
        startBypass()
    else
        TweenService:Create(toggleSwitch, tweenInfo, {BackgroundColor3 = Color3.fromRGB(45, 42, 65)}):Play()
        TweenService:Create(tsStroke, tweenInfo, {Color = Color3.fromRGB(60, 55, 85)}):Play()
        TweenService:Create(toggleKnob, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 3, 0.5, -10), BackgroundColor3 = Color3.fromRGB(150, 148, 170)
        }):Play()
        TweenService:Create(knobGlow, tweenInfo, {Thickness = 0}):Play()
        TweenService:Create(statusDot, tweenInfo, {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
        statusDot.BackgroundTransparency = 0
        TweenService:Create(toggleLabel, tweenInfo, {TextColor3 = Color3.fromRGB(180, 175, 205)}):Play()
        statusText.Text = "Status: Inactive"
        statusText.TextColor3 = Color3.fromRGB(90, 88, 115)
        if dotPulseConnection then dotPulseConnection:Disconnect(); dotPulseConnection = nil end
    end
end

