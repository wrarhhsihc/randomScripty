local activeRenameIndex = nil
local activeRenameNameLabel = nil

local function openRenameDialog(wpIndex, nameLabel, currentName)
	activeRenameIndex = wpIndex
	activeRenameNameLabel = nameLabel
	renameInput.Text = currentName
	renameOverlay.Visible = true

	-- Fade in overlay
	renameOverlay.BackgroundTransparency = 1
	TweenService:Create(renameOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.35}):Play()

	-- Dialog bounce in
	renameDialog.Size = UDim2.new(0, 200, 0, 20)
	renameDialog.Position = UDim2.new(0.5, -100, 0.5, -10)
	renameDialog.BackgroundTransparency = 0.5
	dialogGlow.ImageTransparency = 1

	TweenService:Create(renameDialog, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 240, 0, 155),
		Position = UDim2.new(0.5, -120, 0.5, -78),
		BackgroundTransparency = 0
	}):Play()
	TweenService:Create(dialogGlow, TweenInfo.new(0.5), {ImageTransparency = 0.75}):Play()

	task.wait(0.2)
	renameInput:CaptureFocus()
end

local function closeRenameDialog()
	TweenService:Create(renameOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
	TweenService:Create(renameDialog, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 200, 0, 20),
		BackgroundTransparency = 0.8
	}):Play()
	TweenService:Create(dialogGlow, TweenInfo.new(0.2), {ImageTransparency = 1}):Play()
	task.wait(0.25)
	renameOverlay.Visible = false
	activeRenameIndex = nil
	activeRenameNameLabel = nil
end

local function confirmRename()
	local newName = renameInput.Text
	if newName == "" then newName = "Waypoint" end
	if #newName > 24 then newName = string.sub(newName, 1, 24) end
	for _, wp in ipairs(waypoints) do
		if wp.index == activeRenameIndex then wp.name = newName; break end
	end
	if activeRenameNameLabel then
		activeRenameNameLabel.Text = "📍 " .. newName
		-- Flash the name
		TweenService:Create(activeRenameNameLabel, tweenFast, {TextColor3 = Color3.fromRGB(150, 255, 150)}):Play()
		task.delay(0.3, function()
			if activeRenameNameLabel and activeRenameNameLabel.Parent then
				TweenService:Create(activeRenameNameLabel, tweenFast, {TextColor3 = Color3.fromRGB(200, 195, 230)}):Play()
			end
		end)
	end
	createRipple(renameConfirmBtn)
	closeRenameDialog()
end

renameConfirmBtn.MouseButton1Click:Connect(confirmRename)
renameCancelBtn.MouseButton1Click:Connect(function()
	createRipple(renameCancelBtn)
	closeRenameDialog()
end)

renameInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then confirmRename() end
end)

renameOverlay.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local mousePos = input.Position
		local dialogPos = renameDialog.AbsolutePosition
		local dialogSize = renameDialog.AbsoluteSize
		if mousePos.X < dialogPos.X or mousePos.X > dialogPos.X + dialogSize.X or
			mousePos.Y < dialogPos.Y or mousePos.Y > dialogPos.Y + dialogSize.Y then
			closeRenameDialog()
		end
	end
end)

