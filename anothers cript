-- KEYBIND INPUT HANDLER (FIXED)
-- ============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- Listening mode
    if listeningForKey then
        local sid = listeningForKey
        local kc = input.KeyCode

        -- Cancel listening first so the pulse coroutine stops BEFORE we update display
        listeningForKey = nil

        if kc == Enum.KeyCode.Escape then
            -- Just cancel, restore display
            local s = keybindSlotFrames[sid]
            if s and s.Parent then
                local kbtn = s:FindFirstChild("KeyBtn")
                if kbtn then
                    local kl = kbtn:FindFirstChild("KeyLabel") or kbtn:FindFirstChildWhichIsA("TextLabel")
                    if kl then
                        kl.TextTransparency = 0
                    end
                    local ks = kbtn:FindFirstChildWhichIsA("UIStroke")
                    if ks then TweenService:Create(ks, tweenFast, {Color = Color3.fromRGB(62, 52, 110)}):Play() end
                    TweenService:Create(kbtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(35, 30, 58)}):Play()
                end
                updateKeybindDisplay(sid)
            end
            return
        end

        -- Check duplicates
        local isDuplicate = false
        for id, kb in pairs(keybinds) do
            if id ~= sid and kb and kb.key == kc then
                isDuplicate = true
                break
            end
        end

        if isDuplicate then
            local s = keybindSlotFrames[sid]
            if s and s.Parent then
                -- Reset the key button visual since we cancelled listening
                local kbtn = s:FindFirstChild("KeyBtn")
                if kbtn then
                    local kl = kbtn:FindFirstChild("KeyLabel") or kbtn:FindFirstChildWhichIsA("TextLabel")
                    if kl then
                        kl.TextTransparency = 0
                    end
                    local ks = kbtn:FindFirstChildWhichIsA("UIStroke")
                    if ks then TweenService:Create(ks, tweenFast, {Color = Color3.fromRGB(62, 52, 110)}):Play() end
                    TweenService:Create(kbtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(35, 30, 58)}):Play()
                end
                updateKeybindDisplay(sid)

                -- Flash red for error
                TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(55, 20, 20)}):Play()
                task.delay(0.3, function()
                    if s and s.Parent then
                        TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(20, 18, 38)}):Play()
                    end
                end)
            end
            return
        end

        -- Valid key - assign it
        if keybinds[sid] then
            keybinds[sid].key = kc
        end

        -- Force update the display immediately with correct values
        local s = keybindSlotFrames[sid]
        if s and s.Parent then
            local kbtn = s:FindFirstChild("KeyBtn")
            if kbtn then
                -- Directly set the key label text and color (don't rely on updateKeybindDisplay alone)
                local kl = kbtn:FindFirstChild("KeyLabel") or kbtn:FindFirstChildWhichIsA("TextLabel")
                if kl then
                    kl.Text = kc.Name
                    kl.TextTransparency = 0
                    kl.TextColor3 = Color3.fromRGB(195, 175, 250)
                end

                -- Reset button styling
                local ks = kbtn:FindFirstChildWhichIsA("UIStroke")
                if ks then TweenService:Create(ks, tweenFast, {Color = Color3.fromRGB(62, 52, 110)}):Play() end

                -- Green flash for success
                TweenService:Create(kbtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(28, 62, 28)}):Play()
                task.delay(0.25, function()
                    if kbtn and kbtn.Parent then
                        TweenService:Create(kbtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(35, 30, 58)}):Play()
                    end
                end)
            end

            -- Also run the full display update for the dot etc
            updateKeybindDisplay(sid)

            -- Slot flash
            TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(25, 40, 25)}):Play()
            task.delay(0.25, function()
                if s and s.Parent then
                    TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(20, 18, 38)}):Play()
                end
            end)
        end
        return
    end

    -- Execute keybinds (not listening mode)
    for sid, kb in pairs(keybinds) do
        if kb and kb.key == input.KeyCode and kb.waypointIndex then
            local pos2 = getWpPos(kb.waypointIndex)
            if pos2 then
                character = player.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    character.HumanoidRootPart.CFrame = CFrame.new(pos2)
                    local s = keybindSlotFrames[sid]
                    if s and s.Parent then
                        TweenService:Create(s, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(35, 110, 35)}):Play()
                        local ss = s:FindFirstChildWhichIsA("UIStroke")
                        if ss then TweenService:Create(ss, TweenInfo.new(0.1), {Color = Color3.fromRGB(70, 195, 70)}):Play() end
                        task.delay(0.35, function()
                            if s and s.Parent then
                                TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(20, 18, 38)}):Play()
                                if ss then TweenService:Create(ss, tweenFast, {Color = Color3.fromRGB(44, 38, 72)}):Play() end
                            end
                        end)
                    end
                end
            end
        end
    end
end)

-- ============================================
-- KEYBIND SLOT HELPERS
-- ============================================
local function getWpName(wpIdx)
    if not wpIdx then return "None" end
    for _, wp in ipairs(waypoints) do if wp.index == wpIdx then return wp.name end end
    return "Deleted"
end

local function getWpPos(wpIdx)
    if not wpIdx then return nil end
    for _, wp in ipairs(waypoints) do if wp.index == wpIdx then return wp.position end end
    return nil
end

function updateKeybindDisplay(slotId)
    local slot = keybindSlotFrames[slotId]
    if not slot or not slot.Parent then return end
    local kb = keybinds[slotId]
    if not kb then return end

    local kl = slot:FindFirstChild("KeyLabel")
    if kl then
        kl.Text = kb.key and kb.key.Name or "?"
        kl.TextColor3 = kb.key and Color3.fromRGB(195, 175, 250) or Color3.fromRGB(90, 82, 125)
    end

    local wl = slot:FindFirstChild("WpLabel")
    if wl then
        if kb.waypointIndex then
            wl.Text = "📍 " .. getWpName(kb.waypointIndex)
            wl.TextColor3 = Color3.fromRGB(160, 150, 215)
        else
            wl.Text = "No waypoint assigned"
            wl.TextColor3 = Color3.fromRGB(72, 68, 100)
        end
    end

    local sd = slot:FindFirstChild("SlotDot")
    if sd then
        if kb.key and kb.waypointIndex then
            TweenService:Create(sd, tweenFast, {BackgroundColor3 = Color3.fromRGB(90, 210, 90)}):Play()
        elseif kb.key then
            TweenService:Create(sd, tweenFast, {BackgroundColor3 = Color3.fromRGB(210, 170, 50)}):Play()
        else
            TweenService:Create(sd, tweenFast, {BackgroundColor3 = Color3.fromRGB(70, 68, 70)}):Play()
        end
    end
end

