-- Variables
local enabled = false
local connection = nil

-- Keywords to search
local keywords = {
    "cooldown", "cd", "duration", "hold", "time", "delay", 
    "charge", "cast", "channel", "progress", "fill", "bar"
}

-- Function to reset all values
local function resetAllValues()
    local count = 0
    local searchAreas = {}
    
    if LocalPlayer.Character then
        table.insert(searchAreas, LocalPlayer.Character)
    end
    table.insert(searchAreas, LocalPlayer.Backpack)
    table.insert(searchAreas, LocalPlayer)
    
    -- Search ReplicatedStorage too (some games store ability data there)
    pcall(function()
        table.insert(searchAreas, game:GetService("ReplicatedStorage"))
    end)
    
    for _, area in pairs(searchAreas) do
        if area then
            -- Reset NumberValue and IntValue
            for _, v in pairs(area:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    for _, key in ipairs(keywords) do
                        if v.Name:lower():find(key) then
                            v.Value = 0
                            count = count + 1
                            break
                        end
                    end
                end
            end
            
            -- Reset Attributes
            pcall(function()
                for _, obj in pairs(area:GetDescendants()) do
                    for attrName, attrValue in pairs(obj:GetAttributes()) do
                        for _, key in ipairs(keywords) do
                            if attrName:lower():find(key) and typeof(attrValue) == "number" then
                                obj:SetAttribute(attrName, 0)
                                count = count + 1
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
    
    return count
end

-- Function to instantly complete hold (runs every frame when enabled)
local function instantHoldLoop()
    connection = game:GetService("RunService").RenderStepped:Connect(function()
        if not enabled then return end
        
        -- Method 1: Find and max out progress bars
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in pairs(playerGui:GetDescendants()) do
                -- Look for progress bars (usually frames with Size changing)
                if gui:IsA("Frame") or gui:IsA("ImageLabel") then
                    local name = gui.Name:lower()
                    if name:find("fill") or name:find("bar") or name:find("progress") or name:find("hold") then
                        pcall(function()
                            gui.Size = UDim2.new(1, 0, 1, 0)
                        end)
                    end
                end
                
                -- Look for text showing time remaining
                if gui:IsA("TextLabel") or gui:IsA("TextButton") then
                    local name = gui.Name:lower()
                    if name:find("time") or name:find("duration") or name:find("hold") then
                        pcall(function()
                            gui.Text = "0"
                        end)
                    end
                end
            end
        end
        
        -- Method 2: Reset all cooldown/duration values constantly
        resetAllValues()
    end)
end

-- Toggle Button
ToggleButton.MouseButton1Click:Connect(function()
