local function confirmRename()
	local nn = renameInput.Text
	if nn == "" then nn = "Waypoint" end
	if #nn > 24 then nn = string.sub(nn, 1, 24) end
	for _, wp in ipairs(waypoints) do
		if wp.index == activeRenameIndex then wp.name = nn; break end
	end
	if activeRenameNameLabel then
		activeRenameNameLabel.Text = "📍 " .. nn
		TweenService:Create(activeRenameNameLabel, tweenFast, {TextColor3 = Color3.fromRGB(150, 255, 150)}):Play()
		local ref = activeRenameNameLabel
		task.delay(0.3, function()
			if ref.Parent then TweenService:Create(ref, tweenFast, {TextColor3 = Color3.fromRGB(200, 195, 230)}):Play() end
		end)
	end
	closeRenameDialog()
end

