-- DRAGGING + RESIZING
-- ============================================
local dragging, dragStart, startPos = false, nil, nil
local resizingActive, resizeStart, startSize = false, nil, nil

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = outerGlow.Position
    end
end)
topBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizingActive = true; resizeStart = input.Position; startSize = outerGlow.AbsoluteSize
    end
end)
resizeHandle.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizingActive = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if dragging and dragStart then
            local d = input.Position - dragStart
            outerGlow.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        elseif resizingActive and resizeStart and not minimized then
            local d = input.Position - resizeStart
            outerGlow.Size = UDim2.new(0, math.clamp(startSize.X + d.X, MIN_WIDTH, MAX_WIDTH), 0, math.clamp(startSize.Y + d.Y, MIN_HEIGHT, MAX_HEIGHT))
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false; resizingActive = false
    end
end)

