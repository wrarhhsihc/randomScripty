	local function refreshWaypointButtons()
		for _, c in ipairs(wpBtnContainer:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end

		if #waypoints == 0 then
			local noWpBtn = Instance.new("TextButton")
