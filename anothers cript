			TweenService:Create(gearStroke, tweenFast, {Color = Color3.fromRGB(70, 60, 120)}):Play()
			TweenService:Create(gearBtn, TweenInfo.new(0.3), {Rotation = 0}):Play()

			task.delay(0.25, function() settingsPanel.Visible = false end)
		end
