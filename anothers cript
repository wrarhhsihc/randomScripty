local activeParticles = {}

local function spawnParticle()
	local p = Instance.new("Frame")
	local s = math.random(2, 5)
	p.Size = UDim2.new(0, s, 0, s)
	p.Position = UDim2.new(math.random() * 0.9 + 0.05, 0, 1.05, 0)
	p.BackgroundColor3 = Color3.fromHSV(0.72 + math.random() * 0.12, 0.5 + math.random() * 0.3, 0.6 + math.random() * 0.4)
	p.BackgroundTransparency = 0.5 + math.random() * 0.3
	p.BorderSizePixel = 0
	p.ZIndex = 0
	p.Parent = particleContainer
	local pc = Instance.new("UICorner")
	pc.CornerRadius = UDim.new(1, 0)
	pc.Parent = p
	local dur = 3 + math.random() * 4
	local xd = (math.random() - 0.5) * 0.15
	local mt = TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
		Position = UDim2.new(p.Position.X.Scale + xd, 0, -0.1, 0),
		BackgroundTransparency = 1,
		Size = UDim2.new(0, s * 0.3, 0, s * 0.3)
	})
	mt:Play()
	mt.Completed:Connect(function() p:Destroy() end)
	table.insert(activeParticles, p)
	if #activeParticles > 15 then
		local old = table.remove(activeParticles, 1)
		if old and old.Parent then old:Destroy() end
	end
end

local particleTimer = 0
local particleConnection = RunService.Heartbeat:Connect(function(dt)
	particleTimer = particleTimer + dt
	if particleTimer >= 0.6 then
		particleTimer = 0
		if not minimized then spawnParticle() end
	end
end)

