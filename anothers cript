		end
	end
end)

-- ============================================
-- ANIMATED OUTLINE + BREATHING
-- ============================================
local outlineHue = 0
local breathTimer = 0

local outlineConnection = RunService.Heartbeat:Connect(function(dt)
	outlineHue = (outlineHue + dt * 0.08) % 1
	breathTimer = breathTimer + dt

	-- Main stroke color cycle
	local h1 = (0.72 + math.sin(outlineHue * math.pi * 2) * 0.08) % 1
	local color1 = Color3.fromHSV(h1, 0.6, 0.85)
	mainStroke.Color = color1

	-- Inner stroke offset
	local h2 = (0.72 + math.sin((outlineHue + 0.3) * math.pi * 2) * 0.08) % 1
	local color2 = Color3.fromHSV(h2, 0.5, 0.55)
	innerStroke.Color = color2

	-- Glow pulse
	local pulse1 = 0.6 + math.sin(breathTimer * 1.2) * 0.15
	local pulse2 = 0.5 + math.sin(breathTimer * 1.5 + 0.5) * 0.12
	local pulse3 = 0.78 + math.sin(breathTimer * 0.8 + 1) * 0.1

	glowLayer1.ImageTransparency = pulse1
	glowLayer2.ImageTransparency = pulse2
	glowLayer3.ImageTransparency = pulse3

	local glowColor = Color3.fromHSV(h1, 0.7, 0.75)
	glowLayer1.ImageColor3 = glowColor
	glowLayer2.ImageColor3 = color1
	glowLayer3.ImageColor3 = Color3.fromHSV(h2, 0.6, 0.5)

	-- Stroke thickness breathing
	mainStroke.Thickness = 2 + math.sin(breathTimer * 1.8) * 0.4

	-- Background subtle breathing
	local bgBright = 18 + math.sin(breathTimer * 0.7) * 2
	mainFrame.BackgroundColor3 = Color3.fromRGB(bgBright, bgBright, bgBright + 10)
end)

