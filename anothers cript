-- Rename state
local activeRenameIndex = nil
local activeRenameNameLabel = nil

local function openRenameDialog(wpIndex, nameLabel, currentName)
	activeRenameIndex = wpIndex
	activeRenameNameLabel = nameLabel
	renameInput.Text = currentName
	renameOverlay.Visible = true

	-- Animate in
	renameDialog.Size = UDim2.new(0, 240, 0, 0)
	renameDialog.BackgroundTransparency = 1
	TweenService:Create(renameDialog, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 240, 0, 150),
		BackgroundTransparency = 0
	}):Play()

	task.wait(0.1)
	renameInput:CaptureFocus()
end

local function closeRenameDialog()
	TweenService:Create(renameDialog, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
		Size = UDim2.new(0, 240, 0, 0),
		BackgroundTransparency = 1
	}):Play()
	task.wait(0.2)
	renameOverlay.Visible = false
	activeRenameIndex = nil
	activeRenameNameLabel = nil
end

local function confirmRename()
	local newName = renameInput.Text
	if newName == "" then newName = "Waypoint" end

	-- Max length
	if #newName > 24 then
		newName = string.sub(newName, 1, 24)
	end

	-- Update data
	for _, wp in ipairs(waypoints) do
		if wp.index == activeRenameIndex then
			wp.name = newName
			break
		end
	end

	-- Update label
	if activeRenameNameLabel then
		activeRenameNameLabel.Text = "📍 " .. newName
	end

	closeRenameDialog()
end

renameConfirmBtn.MouseButton1Click:Connect(confirmRename)
renameCancelBtn.MouseButton1Click:Connect(closeRenameDialog)

-- Enter key to confirm
renameInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		confirmRename()
	end
end)

-- Click overlay background to cancel
renameOverlay.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- Only close if clicking the backdrop, not the dialog
		local mousePos = input.Position
		local dialogPos = renameDialog.AbsolutePosition
		local dialogSize = renameDialog.AbsoluteSize
		if mousePos.X < dialogPos.X or mousePos.X > dialogPos.X + dialogSize.X or
			mousePos.Y < dialogPos.Y or mousePos.Y > dialogPos.Y + dialogSize.Y then
			closeRenameDialog()
		end
	end
end)

