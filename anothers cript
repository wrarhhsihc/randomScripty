-- ============================================
-- TAB SWITCHING WITH ANIMATION
-- ============================================
local function switchTab(tabName)
	if currentTab == tabName then return end
	currentTab = tabName

	-- Content slide animation
	if tabName == "Bypass" then
		TweenService:Create(tabHighlight, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -15)}):Play()
		TweenService:Create(tabIndicator, tweenInfo, {Position = UDim2.new(0.25, -10, 1, 3)}):Play()
		TweenService:Create(bypassTabBtn, tweenFast, {TextColor3 = Color3.fromRGB(230, 220, 255)}):Play()
		bypassTabBtn.Font = Enum.Font.GothamBold
		TweenService:Create(waypointTabBtn, tweenFast, {TextColor3 = Color3.fromRGB(140, 140, 160)}):Play()
		waypointTabBtn.Font = Enum.Font.GothamMedium

		-- Slide out waypoint content
		TweenService:Create(waypointContent, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
			Position = UDim2.new(0.3, 10, 0, 95)
		}):Play()
		task.wait(0.15)
		waypointContent.Visible = false

		-- Slide in bypass content
		bypassContent.Position = UDim2.new(-0.3, 10, 0, 95)
		bypassContent.Visible = true
		TweenService:Create(bypassContent, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
			Position = UDim2.new(0, 10, 0, 95)
		}):Play()
	else
		TweenService:Create(tabHighlight, tweenInfo, {Position = UDim2.new(0.5, 3, 0.5, -15)}):Play()
		TweenService:Create(tabIndicator, tweenInfo, {Position = UDim2.new(0.75, -10, 1, 3)}):Play()
		TweenService:Create(waypointTabBtn, tweenFast, {TextColor3 = Color3.fromRGB(230, 220, 255)}):Play()
		waypointTabBtn.Font = Enum.Font.GothamBold
		TweenService:Create(bypassTabBtn, tweenFast, {TextColor3 = Color3.fromRGB(140, 140, 160)}):Play()
		bypassTabBtn.Font = Enum.Font.GothamMedium

		-- Slide out bypass content
		TweenService:Create(bypassContent, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
			Position = UDim2.new(-0.3, 10, 0, 95)
		}):Play()
		task.wait(0.15)
		bypassContent.Visible = false

		-- Slide in waypoint content
		waypointContent.Position = UDim2.new(0.3, 10, 0, 95)
		waypointContent.Visible = true
		TweenService:Create(waypointContent, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
			Position = UDim2.new(0, 10, 0, 95)
		}):Play()
	end
end

