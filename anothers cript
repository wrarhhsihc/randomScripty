local function createRipple(parent, inputPosition)
	local ripple = Instance.new("Frame")
	ripple.BackgroundColor3 = Color3.fromRGB(150, 120, 255)
	ripple.BackgroundTransparency = 0.6
	ripple.BorderSizePixel = 0
	ripple.ZIndex = 99
	local ps = parent.AbsoluteSize
	local pp = parent.AbsolutePosition
	local rx = inputPosition and (inputPosition.X - pp.X) or (ps.X / 2)
	local ry = inputPosition and (inputPosition.Y - pp.Y) or (ps.Y / 2)
	ripple.Position = UDim2.new(0, rx, 0, ry)
	ripple.Size = UDim2.new(0, 0, 0, 0)
	ripple.AnchorPoint = Vector2.new(0.5, 0.5)
	ripple.Parent = parent
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(1, 0)
	rc.Parent = ripple
	local ms = math.max(ps.X, ps.Y) * 2.5
	TweenService:Create(ripple, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, ms, 0, ms),
		BackgroundTransparency = 1
	}):Play()
	task.delay(0.6, function() ripple:Destroy() end)
end

