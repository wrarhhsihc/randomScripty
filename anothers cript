local outlineHue = 0
local breathTimer = 0

local outlineConnection = RunService.Heartbeat:Connect(function(dt)
	outlineHue = (outlineHue + dt * 0.08) % 1
	breathTimer = breathTimer + dt
	local h1 = (0.72 + math.sin(outlineHue * math.pi * 2) * 0.08) % 1
	local color1 = Color3.fromHSV(h1, 0.6, 0.85)
	mainStroke.Color = color1
	local h2 = (0.72 + math.sin((outlineHue + 0.3) * math.pi * 2) * 0.08) % 1
	innerStroke.Color = Color3.fromHSV(h2, 0.5, 0.55)
	local p1 = 0.6 + math.sin(breathTimer * 1.2) * 0.15
	local p2 = 0.5 + math.sin(breathTimer * 1.5 + 0.5) * 0.12
	local p3 = 0.78 + math.sin(breathTimer * 0.8 + 1) * 0.1
	glowLayer1.ImageTransparency = p1
	glowLayer2.ImageTransparency = p2
	glowLayer3.ImageTransparency = p3
	glowLayer1.ImageColor3 = Color3.fromHSV(h1, 0.7, 0.75)
	glowLayer2.ImageColor3 = color1
	glowLayer3.ImageColor3 = Color3.fromHSV(h2, 0.6, 0.5)
	mainStroke.Thickness = 2 + math.sin(breathTimer * 1.8) * 0.4
	local bg = 18 + math.sin(breathTimer * 0.7) * 2
	mainFrame.BackgroundColor3 = Color3.fromRGB(bg, bg, bg + 10)
end)

