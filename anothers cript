-- ============================================
-- KEYBIND INPUT HANDLER
-- ============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		-- Check if listening for a key bind
		if listeningForKey then
			local slotId = listeningForKey
			local keyCode = input.KeyCode

			-- Don't allow certain keys
			if keyCode == Enum.KeyCode.Escape then
				-- Cancel binding
				listeningForKey = nil
				updateKeybindSlotDisplay(slotId)
				local keyBtn = keybindSlotFrames[slotId]:FindFirstChild("KeyBtn")
				if keyBtn then
					local keyBtnStroke = keyBtn:FindFirstChildWhichIsA("UIStroke")
					TweenService:Create(keyBtnStroke, tweenFast, {Color = Color3.fromRGB(70, 60, 120)}):Play()
					TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(40, 35, 65)}):Play()
				end
				return
			end

			-- Check for duplicate keys
			for id, kb in pairs(keybinds) do
				if id ~= slotId and kb.key == keyCode then
					-- Flash error
					local s = keybindSlotFrames[slotId]
					TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(60, 25, 25)}):Play()
					task.wait(0.3)
					TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(26, 24, 42)}):Play()
					return
				end
			end

			keybinds[slotId].key = keyCode
			listeningForKey = nil

			updateKeybindSlotDisplay(slotId)

			local keyBtn = keybindSlotFrames[slotId]:FindFirstChild("KeyBtn")
			if keyBtn then
				local keyBtnStroke = keyBtn:FindFirstChildWhichIsA("UIStroke")
				TweenService:Create(keyBtnStroke, tweenFast, {Color = Color3.fromRGB(70, 60, 120)}):Play()
				TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(40, 35, 65)}):Play()

				-- Success flash
				TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(30, 70, 30)}):Play()
				task.wait(0.2)
				TweenService:Create(keyBtn, tweenFast, {BackgroundColor3 = Color3.fromRGB(40, 35, 65)}):Play()
			end

			-- Bounce slot
			local s = keybindSlotFrames[slotId]
			TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(35, 45, 35)}):Play()
			task.wait(0.2)
			TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(26, 24, 42)}):Play()
			return
		end

		-- Check if any keybind matches the pressed key
		for slotId, kb in pairs(keybinds) do
			if kb.key == input.KeyCode and kb.waypointIndex then
				local pos = getWaypointPosition(kb.waypointIndex)
				if pos then
					character = player.Character
					if character and character:FindFirstChild("HumanoidRootPart") then
						character.HumanoidRootPart.CFrame = CFrame.new(pos)

						-- Visual feedback on the slot
						local s = keybindSlotFrames[slotId]
						if s then
							TweenService:Create(s, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(40, 120, 40)}):Play()
							local sStroke = s:FindFirstChildWhichIsA("UIStroke")
							if sStroke then
								TweenService:Create(sStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(80, 200, 80)}):Play()
							end

							task.wait(0.3)
							TweenService:Create(s, tweenFast, {BackgroundColor3 = Color3.fromRGB(26, 24, 42)}):Play()
							if sStroke then
								TweenService:Create(sStroke, tweenFast, {Color = Color3.fromRGB(50, 45, 80)}):Play()
							end
						end
					end
				end
			end
		end
	end
end)

