    shootStar.Rotation = 35
    shootStar.ZIndex = 1
    shootStar.Parent = cosmicContainer
    Instance.new("UICorner", shootStar).CornerRadius = UDim.new(1, 0)

    -- Trail
    TweenService:Create(shootStar, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 30, 0, 2)
    }):Play()

    task.wait(0.15)

    TweenService:Create(shootStar, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
        Position = UDim2.new(startX + 0.3, 0, startY + 0.25, 0),
        Size = UDim2.new(0, 2, 0, 1),
        BackgroundTransparency = 1
    }):Play()

    task.delay(0.6, function() shootStar:Destroy() end)
end

-- Floating particles (cosmic dust)
local cosmicParticles = {}
local function spawnCosmicParticle()
    local p = Instance.new("Frame")
    local s = math.random(2, 4)
    p.Size = UDim2.new(0, s, 0, s)
    p.Position = UDim2.new(math.random() * 0.9 + 0.05, 0, 1.05, 0)
    p.BackgroundColor3 = Color3.fromHSV(
        0.65 + math.random() * 0.2,
        0.4 + math.random() * 0.3,
        0.5 + math.random() * 0.5
    )
    p.BackgroundTransparency = 0.4 + math.random() * 0.3
    p.BorderSizePixel = 0
    p.ZIndex = 1
    p.Parent = cosmicContainer
    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

    local dur = 4 + math.random() * 5
    local xd = (math.random() - 0.5) * 0.2

    TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Position = UDim2.new(p.Position.X.Scale + xd, 0, -0.1, 0),
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 1, 0, 1)
    }):Play()

    task.delay(dur, function() p:Destroy() end)
    table.insert(cosmicParticles, p)
    if #cosmicParticles > 20 then
        local old = table.remove(cosmicParticles, 1)
        if old and old.Parent then old:Destroy() end
    end
end

-- Cosmic animation loop
local cosmicTimer = 0
local shootingStarTimer = 0
local nebulaTime = 0

local cosmicConnection = RunService.Heartbeat:Connect(function(dt)
    if minimized then return end

    cosmicTimer = cosmicTimer + dt
    shootingStarTimer = shootingStarTimer + dt
    nebulaTime = nebulaTime + dt

    -- Twinkle stars
    for _, starData in ipairs(stars) do
        if starData.frame and starData.frame.Parent then
            local t = math.sin(cosmicTimer * starData.twinkleSpeed + starData.twinkleOffset)
            starData.frame.BackgroundTransparency = starData.baseTransp + t * 0.25
        end
    end

    -- Float nebulae slowly
    if nebula1 and nebula1.Parent then
        local nx = 0.15 + math.sin(nebulaTime * 0.1) * 0.05
        local ny = 0.3 + math.cos(nebulaTime * 0.08) * 0.04
        nebula1.Position = UDim2.new(nx, -90, ny, -90)
    end
    if nebula2 and nebula2.Parent then
        local nx = 0.75 + math.cos(nebulaTime * 0.12) * 0.04
        local ny = 0.6 + math.sin(nebulaTime * 0.09) * 0.05
        nebula2.Position = UDim2.new(nx, -75, ny, -75)
    end
    if nebula3 and nebula3.Parent then
        local nx = 0.5 + math.sin(nebulaTime * 0.07 + 1) * 0.06
        local ny = 0.8 + math.cos(nebulaTime * 0.11) * 0.03
        nebula3.Position = UDim2.new(nx, -60, ny, -60)
    end
    if nebula4 and nebula4.Parent then
        local nx = 0.85 + math.cos(nebulaTime * 0.09 + 2) * 0.04
        local ny = 0.15 + math.sin(nebulaTime * 0.06) * 0.05
        nebula4.Position = UDim2.new(nx, -100, ny, -100)
    end

    -- Nebula color breathing
    local hShift = math.sin(nebulaTime * 0.15) * 0.03
    nebula1.BackgroundColor3 = Color3.fromHSV((0.75 + hShift) % 1, 0.7, 0.45)
    nebula2.BackgroundColor3 = Color3.fromHSV((0.62 + hShift) % 1, 0.6, 0.5)
    nebula3.BackgroundColor3 = Color3.fromHSV((0.85 + hShift) % 1, 0.65, 0.35)

    -- Spawn cosmic particles
    if cosmicTimer >= 0.5 then
        cosmicTimer = 0
        spawnCosmicParticle()
    end

    -- Shooting stars (random interval)
    if shootingStarTimer >= 4 + math.random() * 6 then
        shootingStarTimer = 0
        createShootingStar()
    end
end)

