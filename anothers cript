		}):Play()
		TweenService:Create(knobGlow, tweenInfo, {Thickness = 2, Color = Color3.fromRGB(160, 120, 255)}):Play()
		TweenService:Create(statusDot, tweenInfo, {BackgroundColor3 = Color3.fromRGB(120, 255, 120)}):Play()
		TweenService:Create(statusDotStroke, tweenInfo, {Color = Color3.fromRGB(60, 180, 60)}):Play()
		TweenService:Create(toggleLabel, tweenInfo, {TextColor3 = Color3.fromRGB(230, 230, 250)}):Play()
