function UntrackEntity(ent)
    local d = tracked[ent]
    if not d then return end
    
    pcall(function() d.highlight:Destroy() end)
    pcall(function() d.billboard:Destroy() end)
    if d.conn then d.conn:Disconnect() end
    pcall(function() d.entry:Destroy() end)
    spd[ent] = nil
    
    tracked[ent] = nil
    entCount -= 1
    EntCount.Text = "TARGETS: " .. string.format("%03d", entCount)
    
    DismissAlert(ent.Name:upper())
    Log("LOST SIGNAL: " .. ent.Name)
    
    if entCount == 0 then EmptyScan.Visible = true end
end

function BlacklistEntity(name)
    bl[name] = true
    blCount += 1
    Log("BLACKLISTED: " .. name)
    
    -- Remove all tracked entities with this name
    local toRemove = {}
    for ent, _ in pairs(tracked) do
        if ent.Name == name then
            table.insert(toRemove, ent)
        end
    end
    for _, ent in ipairs(toRemove) do
        UntrackEntity(ent)
    end
    
    -- Add to blacklist view UI
    EmptyBL.Visible = false
    local bEntry = Instance.new("TextLabel")
    bEntry.Size = UDim2.new(1, -4, 0, 28)
    bEntry.BackgroundColor3 = Color3.fromRGB(30, 15, 15)
