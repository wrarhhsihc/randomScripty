local function cleanStr(str) 
    return str:gsub("[%s%p%c]", ""):lower():gsub("[^%w]", "") 
end

local function matchEnt(name)
    if not name then return false end
    local low = name:lower()
    -- Anti-spam blacklist (spawners/despawns/fakes)
    if low:find("spawn") or low:find("despawn") or low:find("template") 
       or low:find("fake") or low:find("decoy") or low:find("dummy")
       or low:find("trigger") or low:find("prompt") or low:find("part") then return false end
    if KNOWN_ENTITIES[cleanStr(name)] then return true end
    -- Rooms strict whitelist (A-Number pattern)
    local num = low:match("^a%-?(%d+)$")
    if num then local n = tonumber(num); if n==60 or n==90 or n==120 or n==200 or n==270 or n==300 then return true end end
    return false
end

local function getMeta(name)
    return THREAT_META[cleanStr(name)] or {lvl="UNKNOWN", col=COLORS.TextDim, tip="⚙ ENTITY CLASSIFIED"}
end

