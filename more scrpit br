local RadarRange = 250
local EntityBlips = {}

function UpdateRadar()
    if not getRadarState() then
        RadarPanel.Visible = false
        return
    end
    RadarPanel.Visible = true
    
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local myPos = root.Position
    local camCF = Camera.CFrame
    
    -- Rotate sweep
    SweepAngle = (SweepAngle + 4) % 360
    SweepLine.Rotation = SweepAngle
    
    -- Calculate orientation vectors for mapping 3D to 2D radar
    local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
    if forward.Magnitude < 0.01 then forward = Vector3.new(0, 0, -1) else forward = forward.Unit end
    local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    if right.Magnitude < 0.01 then right = Vector3.new(1, 0, 0) else right = right.Unit end
    
    -- Update blips
    for ent, data in pairs(tracked) do
        local tp = data.targetPart
        if tp and tp.Parent then
            local dist = (tp.Position - myPos).Magnitude
            if dist <= RadarRange and dist > 0.5 then
                local flatOff = Vector3.new(tp.Position.X - myPos.X, 0, tp.Position.Z - myPos.Z)
                -- Map to radar coordinates (-0.45 to 0.45 range)
                local relX = (right:Dot(flatOff) / RadarRange) * 0.42
                local relY = -(forward:Dot(flatOff) / RadarRange) * 0.42
                
                local blipKey = tostring(ent)
                local blip = EntityBlips[blipKey]
                
                if not blip or not blip.Parent then
                    -- Create new holographic blip
                    blip = Instance.new("Frame")
                    blip.Size = UDim2.new(0, 8, 0, 8)
                    blip.AnchorPoint = Vector2.new(0.5, 0.5)
                    blip.BackgroundColor3 = getMeta(ent.Name).col
                    blip.Parent = RadarPanel
                    Instance.new("UICorner", blip).CornerRadius = UDim.new(0.5, 0)
                    
                    -- Pulse animation for blip
                    local pulse = TweenService:Create(blip, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, -1, true), {
                        Size = UDim2.new(0, 10, 0, 10),
                        BackgroundTransparency = 0.5
                    })
                    pulse:Play()
                    
                    EntityBlips[blipKey] = blip
                end
                
                blip.Position = UDim2.new(0.5 + relX, 0, 0.5 + relY, 0)
            end
        end
    end
    
    -- Clean up dead blips
    for key, blip in pairs(EntityBlips) do
        local ent = nil
        for e, _ in pairs(tracked) do
            if tostring(e) == key then ent = e break end
        end
        if not ent then
            blip:Destroy()
            EntityBlips[key] = nil
        end
    end
    
    local count = 0
    for _ in pairs(EntityBlips) do count += 1 end
    RadarLabel.Text = "LIDAR // SIG:" .. count .. " RNG:" .. RadarRange
end

