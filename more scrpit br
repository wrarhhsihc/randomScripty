local function createToggle(name, defaultState, accentCol)
    local container = Instance.new("TextButton")
    container.Size = UDim2.new(0.25, -4, 1, 0)
    container.BackgroundColor3 = defaultState and Color3.fromRGB(20, 30, 25) or Color3.fromRGB(30, 20, 20)
    container.BorderSizePixel = 0
    container.Text = name .. ": " .. (defaultState and "ON" or "OFF")
    container.TextColor3 = defaultState and COLORS.Safe or COLORS.Danger
    container.Font = Enum.Font.Code
    container.TextSize = 9
    container.Parent = CtrlRow1
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 4)
    Instance.new("UIStroke", container).Color = accentCol
    
    -- Toggle state tracking
    local state = defaultState
    container.MouseButton1Click:Connect(function()
        state = not state
        container.BackgroundColor3 = state and Color3.fromRGB(20, 30, 25) or Color3.fromRGB(30, 20, 20)
        container.TextColor3 = state and COLORS.Safe or COLORS.Danger
        container.Text = name .. ": " .. (state and "ON" or "OFF")
        -- Return state change event would go here
        successSound()
    end)
    
    return container, function() return state end
end

