local function playTone(pitch, duration, volume)
    task.spawn(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://911380868" -- Synth tone base
        s.Volume = volume or 0.4
        s.PlaybackSpeed = pitch or 1
        s.PlayOnRemove = true
        s.Parent = workspace
        task.wait(duration or 1)
        s:Destroy()
    end)
end

