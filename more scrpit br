        DetCount.Text = "DETECTED: " .. totalDetected .. " | ALERTS: " .. totalAlerts
        ThreatLevel.Text = "STATUS: " .. maxThreat
        ThreatLevel.TextColor3 = maxThreatCol
        ProximityData.Text = "PROXIMITY: " .. (nearestName .. " @" .. math.floor(nearestDist) .. "m")
        
