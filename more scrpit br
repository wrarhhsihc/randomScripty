	-- Hover Effects
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(30,30,40) end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = C.Void end)
	return btn
end

-- LOGIC: Entity Whitelist
local Entities = {rush=true, ambush=true, seek=true, figure=true, halt=true, eyes=true, screech=true, dread=true, a60=true, a90=true, a120=true, a200=true, a270=true, a300=true}
local Threat = {rush="LETHAL", ambush="LETHAL", seek="LETHAL", figure="CRITICAL", halt="DANGER", eyes="DANGER", screech="DANGER", dread="LETHAL", a60="LETHAL", a90="CRITICAL", a120="LETHAL", a200="LETHAL", a270="LETHAL", a300="CRITICAL"}

local function cleanStr(s) return s:gsub("[%s%p]", ""):lower() end
local function matchEnt(n)
	if not n then return false end
	local low = n:low():lower()
	if low:find("spawn") or low:find("despawn") or low:find("fake") or low:find("prompt") then return false end
	if Entities[cleanStr(n)] then return true end
	if low:match("^a%-?(%d+)$") then local num=tonumber(low:match("%d+")); if num==60 or num==90 or num==120 or num==200 or num==270 or num==300 then return true end end
	return false
end

local function getMeta(n)
	local id = cleanStr(n)
	local lvl = Threat[id] or "UNKNOWN"
	local col = lvl=="CRITICAL" and C.Magenta or lvl=="LETHAL" and C.Red or lvl=="DANGER" and C.Orange or C.TextDim
	return {lvl=lvl, col=col}
end

