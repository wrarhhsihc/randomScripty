    for ent, d in pairs(tracked) do
        local part = d.targetPart
        if part and part.Parent then
            local rawDist = (myRoot.Position - part.Position).Magnitude
            
            if rawDist < nearestDist then
                nearestDist = rawDist
                nearestName = ent.Name:upper()
            end
            
            -- Update list entries
            if d.entryDist then
                d.entryDist.Text = math.floor(rawDist) .. " STUDS"
                d.entryDist.TextColor3 = rawDist < 50 and COLORS.Danger or (rawDist < 150 and COLORS.Warning or COLORS.TextDim)
            end
            
            -- Speed calc
            local sd = spd[ent]
            if sd then
                local tDiff = now - sd.lastTime
                if tDiff > 0.05 then
                    local currentSpeed = (part.Position - sd.lastPos).Magnitude / tDiff
                    sd.speed = currentSpeed
                    sd.lastPos = part.Position
                    sd.lastTime = now
                    
                    if d.entryStatus then
                        if currentSpeed > 35 then
                            d.entryStatus.Text = "⚡ HIGH VELOCITY: " .. math.floor(currentSpeed) .. "u/s"
                            d.entryStatus.TextColor3 = COLORS.Danger
                        elseif currentSpeed > 5 then
                            d.entryStatus.Text = "◆ MOVEMENT DETECTED"
                            d.entryStatus.TextColor3 = COLORS.Warning
                        else
                            d.entryStatus.Text = "◈ STATIONARY TARGET"
                            d.entryStatus.TextColor3 = COLORS.Safe
                        end
                    end
                end
            end
            
            -- Check threat level
            if d.meta and (d.meta.lvl == "CRITICAL" or d.meta.lvl == "LETHAL" or d.meta.lvl == "DANGER") then
                maxThreat = d.meta.lvl
                maxThreatCol = d.meta.col
                
                -- Auto-defense teleport trigger
                if getShieldState() and rawDist < 120 then
                    Log("AUTO-SHIELD TRIGGERED BY: " .. ent.Name)
                    local closet = findCloset()
