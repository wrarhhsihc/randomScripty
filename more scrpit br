-- ═══ TRACKING CORE ═══
local tracked = {}
local pChars = {}
for _,p in ipairs(Players:GetPlayers()) do
	if p.Character then pChars[p.Character]=true end
	p.CharacterAdded:Connect(function(c) pChars[c]=true end)
	p.CharacterRemoving:Connect(function(c) pChars[c]=nil end)
end

function IsEnt(o)
	if not o or pChars[o] then return false end
	for _,p in ipairs(Players:GetPlayers()) do if p.Character and o:IsDescendantOf(p.Character) then return false end end
	return matchEnt(o.Name)
end

function GetPart(o)
	if o:IsA("BasePart") then return o end
	if o:IsA("Model") then return o:FindFirstChild("HumanoidRootPart") or o:FindFirstChild("Head") or o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart",true) end
	return o:FindFirstChildWhichIsA("BasePart", true)
end

function Track(e)
	if tracked[e] or not e.Parent then return end
	local meta = getMeta(e.Name)
	local root = GetPart(e)
	
	-- Highlight
	local hl = New("Highlight", {Adornee=e, FillColor=meta.col, OutlineColor=meta.col, FillTransparency=0.7, Enabled=espOn, Parent=e})
	
	-- Billboard
	local bb = root and New("BillboardGui", {Adornee=root, Size=UDim2.new(0,150,0,50), AlwaysOnTop=true, Enabled=tagOn, Parent=root}) or nil
	if bb then
		local bg = New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=C.Void,Transparency=0.2,Parent=bb}); New("UICorner",{CornerRadius=UDim.new(0,4),Parent=bg})
		MakeLabel(bg, e.Name:upper(), meta.col, UDim2.new(1,0,0,20), UDim2.new(0,0,0,2)).Font = Enum.Font.Bold
		MakeLabel(bg, meta.lvl, meta.col, UDim2.new(1,0,0,16), UDim2.new(0,0,0,22)).Font = Enum.Font.Code
	end
	
	-- List Entry
	EmptyState.Visible = false
	local entry = New("Frame", {Size=UDim2.new(1,0,0,40),BackgroundColor3=Color3.fromRGB(20,22,30),Parent=Viewport})
	New("UICorner",{CornerRadius=UDim.new(0,4),Parent=entry})
	New("Frame",{Size=UDim2.new(0,3,1,-8),Position=UDim2.new(0,4,0,4),BackgroundColor3=meta.col,BorderSizePixel=0,Parent=entry}) -- Bar
	
	MakeLabel(entry, e.Name:upper(), meta.col, UDim2.new(0.5,0,1,0), UDim2.new(0,14,0,0))
	local distLbl = MakeLabel(entry, "--- ST", C.TextDim, UDim2.new(0.5,0,1,0), UDim2.new(0.5,0,0,0))
	distLbl.TextXAlignment = Enum.TextXAlignment.Right

	tracked[e] = {hl=hl, bb=bb, part=root, entry=entry, distLbl=distLbl, meta=meta}
	ConText.Text = "> DETECTED: "..e.Name.." ["..meta.lvl.."]"
	PlaySound(meta.lvl=="LETHAL" and 0.6 or 2)
end

function Untrack(e)
	local d = tracked[e]; if not d then return end
	d.hl:Destroy(); if d.bb then d.bb:Destroy() end; d.entry:Destroy(); tracked[e]=nil
	if #tracked == 0 then EmptyState.Visible = true end
end

